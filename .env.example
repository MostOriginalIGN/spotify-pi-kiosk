HOST=127.0.0.1
PORT=4928
PUBLIC_BASE_URL=http://127.0.0.1:4928
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:4928/api/auth/callback
# Defaults to this machine's hostname when empty.
SPOTIFY_DEVICE_NAME=
TOKEN_STORE_PATH=./data/tokens.json
SPOTIFY_DEVICE_CACHE_PATH=./data/device-cache.json

# Optional: write OAuth token for librespot-based Connect devices (e.g. Raspotify).
# SPOTIFY_SYNC_CONNECT_TOKEN=1
# SPOTIFY_CONNECT_TOKEN_PATH=./data/connect-token.env

# "Connect from the Spotify app" overlay on the now-playing screen (focus mode).
DEVICE_HINT_ENABLED=1
# How often to show the hint again (milliseconds). Default: 5 minutes.
DEVICE_HINT_INTERVAL_MS=300000
